<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تعزيز / تصحيح النموذج" android:textSize="22sp" android:textStyle="bold"/>
<EditText android:id="@+id/editInteractiveEq" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="2x+3y=5;x-y=1" android:inputType="text"/>
<Button android:id="@+id/btnSolveInteractive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="تقييم النموذج"/>
<TextView android:id="@+id/textInteractiveResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="18sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/layoutFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:visibility="gone">
<Button android:id="@+id/btnReward" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الحل صحيح"/>
<Button android:id="@+id/btnPunish" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الحل خاطئ"/>
</LinearLayout>
<TextView android:id="@+id/textCorrection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp"/>
</LinearLayout></ScrollView>
