<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Equation Solver AI"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="محرك رمزي دقيق + نموذج عصبي للتعلم"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnGoTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="حل معادلة" />

    <Button
        android:id="@+id/btnGoTrain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="تدريب النموذج" />

    <Button
        android:id="@+id/btnGoReinforcement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تعزيز / تصحيح النموذج" />
</LinearLayout>
