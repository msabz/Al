<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حل معادلة" android:textSize="22sp" android:textStyle="bold"/>
<EditText android:id="@+id/editEquation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="2x+3y=5;x-y=1" android:inputType="text"/>
<Button android:id="@+id/btnSolve" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="حل بدقة"/>
<TextView android:id="@+id/textResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="19sp" android:textStyle="bold"/>
<TextView android:id="@+id/textAi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp"/>
</LinearLayout></ScrollView>
