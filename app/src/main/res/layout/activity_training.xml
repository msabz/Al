<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="36dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackTraining"
            style="@style/Button.MathAI.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:text="@string/back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="مختبر التدريب الحقيقي"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="3dp"
            android:text="كل دفعة تنفّذ Forward + Backpropagation + Adam. مجموعة التحقق ثابتة ومحجوزة ولا تدخل التدريب."
            android:textColor="@color/text_secondary"
            android:textDirection="rtl"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.MathAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/textTrainingState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="التدريب متوقف" android:textColor="@color/mint" android:textDirection="rtl" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/textDeviceGuard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="ملف A16 المتوازن: Batch 16 • حماية حرارة وبطارية • حفظ كل 5 دقائق" android:textColor="@color/text_secondary" android:textDirection="rtl" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTrainRandom" style="@style/Button.MathAI.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="@string/start_training" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnStopTraining" style="@style/Button.MathAI.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:enabled="false" android:text="@string/stop_and_save" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="المقاييس الحية" android:textColor="@color/text_primary" android:textDirection="rtl" android:textSize="17sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:gravity="center" android:orientation="vertical" android:padding="13dp"><TextView android:id="@+id/textMetricSamples" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="أمثلة" android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:gravity="center" android:orientation="vertical" android:padding="13dp"><TextView android:id="@+id/textMetricBatches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="دفعات Adam" android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:gravity="center" android:orientation="vertical" android:padding="13dp"><TextView android:id="@+id/textMetricLoss" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/mint" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Train MSE" android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:gravity="center" android:orientation="vertical" android:padding="13dp"><TextView android:id="@+id/textMetricRmse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/sky" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Holdout RMSE" android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:gravity="center" android:orientation="vertical" android:padding="13dp"><TextView android:id="@+id/textMetricAccuracy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/amber" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="دقة ±1" android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:gravity="center" android:orientation="vertical" android:padding="13dp"><TextView android:id="@+id/textMetricGradient" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Gradient norm" android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout>
        </LinearLayout>

        <com.example.equationsolver.LossChartView
            android:id="@+id/lossChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_stat"
            android:padding="8dp" />

        <com.google.android.material.card.MaterialCardView style="@style/Card.MathAI" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/textLiveFamily" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آخر عائلة: —" android:textColor="@color/mint" android:textDirection="rtl" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textLiveEquation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:text="ستظهر هنا معادلة من الدفعة الحقيقية" android:textColor="@color/text_primary" android:textDirection="ltr" android:textIsSelectable="true" android:textSize="17sp" />
                <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="2dp" android:text="اضغط بدء لتهيئة أول دفعة." android:textColor="@color/text_secondary" android:textDirection="rtl" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card.MathAI" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تدريب من ملف" android:textColor="@color/text_primary" android:textDirection="rtl" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="الصيغة: equation | x,y. كل سطر يُفحص بالتعويض قبل دخوله التدريب؛ السطر الخاطئ يُرفض." android:textColor="@color/text_secondary" android:textDirection="rtl" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLoadFile" style="@style/Button.MathAI.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/import_training_file" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
